    "cl_faqs_WUiFMi": {
      "type": "cl-faqs",
      "blocks": {
        "faq_CAmxR8": {
          "type": "faq",
          "settings": {
            "title": "What causes hair thinning?",
            "answer": "<p>Hair thinning can have different underlying causes, including conditions such as<br/>androgenetic alopecia and telogen effluvium. Changes in follicular activity can affect<br/>hair density, thickness and overall quality.</p><p>A qualified healthcare professional can help assess the cause and recommend<br/>appropriate treatment and care.</p>"
          }
        },
        "faq_Fr8tC8": {
          "type": "faq",
          "settings": {
            "title": "Why is scalp health important for healthy hair?",
            "answer": "<p>The scalp provides the environment in which hair follicles function. Maintaining scalp<br/>balance through effective cleansing, exfoliation and targeted care helps support<br/>follicular health and stronger, healthier-looking hair.</p>"
          }
        },
        "faq_TtLf3G": {
          "type": "faq",
          "settings": {
            "title": "What is Wharton Gel Complex® Technology?",
            "answer": "<p>Wharton Gel Complex® is a patented growth factor technology containing growth<br/>factors, hyaluronic acid and glycosaminoglycans. It is designed to support scalp regeneration and follicular activity, helping improve hair strength, thickness and density when incorporated into appropriate professional protocols.</p>"
          }
        },
        "faq_tKFX3w": {
          "type": "faq",
          "settings": {
            "title": "How does the ALLSKIN | MED Hair Regeneration Plan work?",
            "answer": "<p>The three-step plan combines Exfoliating Shampoo to cleanse and balance the scalp,<br/>Anti-Hair Loss & Redensifying Lotion to support follicular activity, and Oral Hair<br/>Capsules to provide nutritional support.</p><p>Designed for at-home use, it complements professional hair regeneration treatments<br/>and supports ongoing scalp care.</p>"
          }
        },
        "faq_tL6wWV": {
          "type": "faq",
          "settings": {
            "title": "How long does it take to see results?",
            "answer": "<p>Results vary according to individual concerns and treatment protocols. In a 16-patient<br/>clinical evaluation, improvements in hair loss, thickness and density were reported after<br/>90 days using the professional Redensifying Booster with microneedling.¹</p><p>These results have not been established for the standalone Hair Regeneration Plan.</p>"
          }
        }
      },
