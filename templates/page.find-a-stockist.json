    "custom_liquid_36TaGn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================\n     CANTABRIA LABS - PROMAP FILTER LAYOUT\n     ========================================== */\n\n  /* Hide ProMap's original filter heading */\n  .scasl-see-more-content\n  > .bh-sl-filters-container.scasl-tag > label {\n    display: none !important;\n  }\n\n  /* Filter list layout */\n  #scasl-tag-list-container.cl-filter-grid {\n    display: grid !important;\n    grid-template-columns: 1fr;\n    gap: 12px !important;\n    width: 100% !important;\n    max-width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    list-style: none !important;\n    align-items: start;\n  }\n\n  /* Reset ProMap's default checkbox layout */\n  #scasl-tag-list-container.cl-filter-grid > li {\n    display: flex !important;\n    align-items: center;\n    width: auto !important;\n    max-width: none !important;\n    min-width: 0;\n    height: auto !important;\n    float: none !important;\n    clear: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    position: static;\n    box-sizing: border-box;\n  }\n\n  /* Checkbox labels */\n  #scasl-tag-list-container.cl-filter-grid\n  > li:not(.cl-group-heading) label {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    width: auto !important;\n    margin: 0 !important;\n    white-space: normal;\n    line-height: 1.5;\n    cursor: pointer;\n  }\n\n  /* Checkboxes */\n  #scasl-tag-list-container.cl-filter-grid\n  > li input[type=\"checkbox\"] {\n    flex-shrink: 0;\n    margin: 0 !important;\n  }\n\n  /* Group headings */\n  #scasl-tag-list-container.cl-filter-grid\n  > li.cl-group-heading {\n    display: block !important;\n    grid-column: 1 / -1;\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    list-style: none;\n    pointer-events: none;\n  }\n\n  /* Divider above retailer group */\n  #scasl-tag-list-container.cl-filter-grid\n  > li.cl-retailer-heading {\n    border-top: 1px solid #e5e5e5;\n    padding-top: 16px !important;\n    margin-top: 8px !important;\n  }\n\n  /* ==========================================\n     DESKTOP\n     ========================================== */\n\n  @media screen and (min-width: 750px) {\n\n    /* Radius and unit side by side */\n    .scasl-see-more-content {\n      display: grid !important;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      column-gap: 16px;\n      row-gap: 24px;\n      align-items: start;\n    }\n\n    /* Dropdown containers */\n    .scasl-see-more-content > .form-input {\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      float: none !important;\n    }\n\n    /* Dropdowns */\n    .scasl-see-more-content > .form-input select {\n      width: 100% !important;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n\n    /* Filters take full row beneath dropdowns */\n    .scasl-see-more-content\n    > .bh-sl-filters-container.scasl-tag {\n      grid-column: 1 / -1;\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      padding: 0 !important;\n      float: none !important;\n    }\n\n    /* Compact horizontal checkbox layout */\n    #scasl-tag-list-container.cl-filter-grid {\n      grid-template-columns:\n        repeat(6, max-content) !important;\n      justify-content: start;\n      column-gap: 20px !important;\n      row-gap: 12px !important;\n    }\n\n    /* Keep checkbox names on one line */\n    #scasl-tag-list-container.cl-filter-grid\n    > li:not(.cl-group-heading) label {\n      white-space: nowrap;\n    }\n  }\n\n  /* ==========================================\n     MOBILE\n     ========================================== */\n\n  @media screen and (max-width: 749px) {\n\n    #scasl-tag-list-container.cl-filter-grid {\n      grid-template-columns: 1fr !important;\n      row-gap: 12px !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-grid\n    > li.cl-retailer-heading {\n      margin-top: 8px !important;\n    }\n  }\n\n  /* Intermediate desktop widths */\n  @media screen and (min-width: 750px)\n    and (max-width: 1100px) {\n\n    #scasl-tag-list-container.cl-filter-grid {\n      grid-template-columns:\n        repeat(3, max-content) !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  /* ==========================================\n     TAG CONFIGURATION\n     ========================================== */\n\n  const brands = [\n    'ALLSKIN | MED',\n    'Biretix',\n    'Endocare',\n    'Heliocare',\n    'Neoretin',\n    'Skin Resist'\n  ];\n\n  const retailerTypes = [\n    'Skin Clinic',\n    'Pharmacy'\n  ];\n\n  const customOrder = [\n    ...brands,\n    ...retailerTypes\n  ];\n\n  const listSelector = '#scasl-tag-list-container';\n\n  const normalise = text =>\n    text.replace(/\\s+/g, ' ').trim().toLowerCase();\n\n  const orderMap = new Map(\n    customOrder.map((name, index) => [\n      normalise(name),\n      index\n    ])\n  );\n\n  const retailerSet = new Set(\n    retailerTypes.map(normalise)\n  );\n\n  let attachedList = null;\n  let observer = null;\n\n  /* ==========================================\n     CREATE GROUP HEADING\n     ========================================== */\n\n  function createHeading(text, className) {\n    const heading = document.createElement('li');\n\n    heading.className =\n      'cl-group-heading ' + className;\n\n    heading.textContent = text;\n    heading.setAttribute('role', 'presentation');\n\n    return heading;\n  }\n\n  /* ==========================================\n     ORGANISE TAGS\n     ========================================== */\n\n  function organiseTags(list) {\n\n    const items = Array.from(list.children)\n      .filter(item =>\n        item.tagName === 'LI' &&\n        !item.classList.contains('cl-group-heading')\n      );\n\n    if (!items.length) return;\n\n    const label = item => {\n      const checkbox = item.querySelector(\n        'input[name=\"tagsvalue\"]'\n      );\n\n      return normalise(\n        checkbox ? checkbox.value : item.textContent\n      );\n    };\n\n    const priority = item => {\n      const name = label(item);\n\n      return orderMap.has(name)\n        ? orderMap.get(name)\n        : customOrder.length;\n    };\n\n    const sorted = [...items].sort((a, b) => {\n      return priority(a) - priority(b) ||\n        label(a).localeCompare(label(b));\n    });\n\n    // Avoid responding to our own DOM changes.\n    if (observer) observer.disconnect();\n\n    const fragment = document.createDocumentFragment();\n\n    // Insert brand heading.\n    fragment.appendChild(\n      createHeading(\n        'Filter by brand',\n        'cl-brand-heading'\n      )\n    );\n\n    let retailerHeadingAdded = false;\n\n    sorted.forEach(item => {\n\n      const name = label(item);\n\n      // Insert retailer heading immediately\n      // before the first retailer type.\n      if (\n        retailerSet.has(name) &&\n        !retailerHeadingAdded\n      ) {\n        fragment.appendChild(\n          createHeading(\n            'Filter by retailer type',\n            'cl-retailer-heading'\n          )\n        );\n\n        retailerHeadingAdded = true;\n      }\n\n      // Remove classes from previous implementation.\n      item.classList.remove(\n        'cl-brand-first',\n        'cl-retailer-first'\n      );\n\n      fragment.appendChild(item);\n    });\n\n    // Replace with the correctly ordered elements.\n    list.replaceChildren(fragment);\n\n    // Activate our grid layout.\n    list.classList.add('cl-filter-grid');\n\n    // Reconnect to ProMap's dynamic updates.\n    if (observer) {\n      observer.observe(list, {\n        childList: true\n      });\n    }\n  }\n\n  /* ==========================================\n     INITIALISE\n     ========================================== */\n\n  function initialise() {\n\n    const list = document.querySelector(listSelector);\n\n    if (!list) return;\n\n    if (list !== attachedList) {\n\n      if (observer) observer.disconnect();\n\n      attachedList = list;\n\n      observer = new MutationObserver(() => {\n        organiseTags(list);\n      });\n\n      observer.observe(list, {\n        childList: true\n      });\n    }\n\n    // Only organise when first loaded or\n    // when ProMap replaces the filter items.\n    const hasHeading = list.querySelector(\n      '.cl-brand-heading'\n    );\n\n    if (!hasHeading) {\n      organiseTags(list);\n    }\n  }\n\n  /* ==========================================\n     WAIT FOR PROMAP TO LOAD\n     ========================================== */\n\n  const poll = setInterval(initialise, 250);\n\n  setTimeout(() => {\n    clearInterval(poll);\n  }, 60000);\n\n  initialise();\n\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
