{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Padding controls */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Base image styles */
  .section-{{ section.id }} .single-image__img {
    display: block;
    margin-inline: auto;
    height: auto;
  }

  /* Mobile image width */
  {%- if section.settings.image_width_unit == '%' -%}
    .section-{{ section.id }} .single-image__img {
      width: {{ section.settings.image_width_mobile }}%;
    }
  {%- else -%}
    .section-{{ section.id }} .single-image__img {
      width: 100%;
      max-width: {{ section.settings.image_width_mobile }}px;
    }
  {%- endif -%}

  /* Desktop image width */
  @media screen and (min-width: 750px) {
    {%- if section.settings.image_width_unit == '%' -%}
      .section-{{ section.id }} .single-image__img {
        width: {{ section.settings.image_width_desktop }}%;
      }
    {%- else -%}
      .section-{{ section.id }} .single-image__img {
        width: 100%;
        max-width: {{ section.settings.image_width_desktop }}px;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<div
  class="isolate{% unless section.settings.full_width %} page-width{% endunless %}"
  id="{{ section.settings.container_id }}"
>
  <div class="rich-text content-container gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper {% if section.settings.full_width %} page-width{% endif %}">

      {%- if section.settings.image != blank -%}

        {%- if section.settings.image_width_unit == 'px' -%}
          {%- capture image_sizes -%}
            (min-width: 750px) {{ section.settings.image_width_desktop }}px,
            {{ section.settings.image_width_mobile }}px
          {%- endcapture -%}
        {%- else -%}
          {%- capture image_sizes -%}
            (min-width: 750px) {{ section.settings.image_width_desktop }}vw,
            {{ section.settings.image_width_mobile }}vw
          {%- endcapture -%}
        {%- endif -%}

        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'single-image__img',
            loading: 'lazy',
            widths: '320, 375, 480, 550, 640, 750, 900, 1100, 1300, 1500, 1800, 2000, 2400',
            sizes: image_sizes,
            alt: section.settings.image.alt
        }}

      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Single Image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "number",
      "id": "image_width_mobile",
      "label": "Mobile image width",
      "default": 400,
      "info": "Enter the image width for mobile."
    },
    {
      "type": "number",
      "id": "image_width_desktop",
      "label": "Desktop image width",
      "default": 800,
      "info": "Enter the image width for desktop."
    },
    {
      "type": "select",
      "id": "image_width_unit",
      "label": "Width unit",
      "options": [
        {
          "value": "px",
          "label": "px"
        },
        {
          "value": "%",
          "label": "%"
        }
      ],
      "default": "px"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "text",
      "id": "container_id",
      "label": "Container ID"
    }
  ],
  "presets": [
    {
      "name": "Single Image"
    }
  ]
}
{% endschema %}