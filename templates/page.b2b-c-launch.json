    "range_cards_d4dm8q": {
      "type": "range-cards",
      "blocks": {
        "range_card_CjtgEz": {
          "type": "range_card",
          "settings": {
            "name": "ALLSKIN | MED",
            "tagline": "Where skin science meets medical aesthetic experience",
            "tags": "Anti-Ageing, Pigmentation, Redness & Reactive Skin, Acne-Prone Skin, Hair & Scalp Health",
            "tags_link": "#categories",
            "summary": "<p>The ALLSKIN | MED medical-grade portfolio provides prescriptive solutions across multiple skin, hair and scalp concerns throughout the patient journey.</p>",
            "outlet_medical": true,
            "medical_exclusive": true,
            "outlet_skin": false,
            "outlet_pharmacy": false,
            "outlet_retail": false,
            "details": "<p>The ALLSKIN | MED portfolio features advanced formulations and strengths suitable for practitioner-led recommendations, supporting treatment preparation, recovery, downtime reduction, treatment result enhancement and long-term improvements in skin health through scientifically and clinically proven regimes.</p><p>ALLSKIN | MED HAIR provides in-clinic products to support treatment results alongside evidence-based home-use regimes to enhance scalp and hair health.</p>"
          }
        },
        "range_card_xihrbw": {
          "type": "range_card",
          "settings": {
            "name": "ENDOCARE",
            "tagline": "Precision anti-ageing science",
            "tags": "Anti-Ageing",
            "tags_link": "#categories",
            "summary": "<p>Precision anti-ageing solutions supporting the skin’s barrier, radiance, texture and renewal through different stages of skin ageing.</p>",
            "outlet_medical": true,
            "medical_exclusive": false,
            "outlet_skin": true,
            "outlet_pharmacy": true,
            "outlet_retail": false,
            "details": "<p>Formulated, developed and clinically proven through dermatological and scientific expertise, ENDOCARE regimes, combinations and targeted products provide precision anti-ageing solutions for healthcare professionals, skin professionals, patients and consumers throughout their anti-ageing and skin health journey.</p>"
          }
        },
        "range_card_tMwCVK": {
          "type": "range_card",
          "settings": {
            "name": "NEORETIN",
            "tagline": "Advanced science for skin hyperpigmentation",
            "tags": "Pigmentation",
            "tags_link": "#categories",
            "summary": "<p>Specialist solutions for the correction of uneven pigmentation and dark spots, helping support clearer, more even-looking skin.</p>",
            "outlet_medical": true,
            "medical_exclusive": false,
            "outlet_skin": true,
            "outlet_pharmacy": true,
            "outlet_retail": false,
            "details": "<p>Using expert formulations scientifically proven to address different stages of excess melanin production and presence, NEORETIN enhances evidence-based skincare regimes by reducing dark spots and evening skin tone in hyperpigmented areas.</p>"
          }
        },
        "range_card_jAmHWp": {
          "type": "range_card",
          "settings": {
            "name": "SKIN RESIST",
            "tagline": "Advanced care for reactive & redness-prone skin",
            "tags": "Redness & Reactive Skin",
            "tags_link": "#categories",
            "summary": "<p>Hydrobiome science designed to help improve the skin’s natural resistance, reduce sensitivity and redness and support the skin barrier, while providing anti-ageing care.</p>",
            "outlet_medical": true,
            "medical_exclusive": false,
            "outlet_skin": true,
            "outlet_pharmacy": true,
            "outlet_retail": false,
            "details": "<p>The hydrobiome science of Aquamunist® harnesses the exclusive soothing, protective and repairing properties of La Concha, Cantabria thermal waters and natural algae extracts, combined with clinically proven sensitivity-reducing and barrier-repairing dermatological ingredients.</p><p>SKIN RESIST is clinically proven to provide a regimen and targeted products that significantly reduce sensitivity, reactivity and redness while delivering significant anti-ageing benefits.</p>"
          }
        },
        "range_card_3pxCzh": {
          "type": "range_card",
          "settings": {
            "name": "BIRETIX",
            "tagline": "Specialist care for acne-prone skin",
            "tags": "Acne-Prone Skin",
            "tags_link": "#categories",
            "summary": "<p>Expertly formulated solutions designed to help reduce and prevent the main signs of acne-prone skin in young people and adults, while supporting skin undergoing medical acne treatments.</p>",
            "outlet_medical": true,
            "medical_exclusive": false,
            "outlet_skin": true,
            "outlet_pharmacy": true,
            "outlet_retail": false,
            "details": "<p>Formulated with unique active retinoid and dermatological ingredients, BIRETIX provides clinically proven regimes and targeted products for acne-prone skin and to help support medical acne treatments.</p>"
          }
        },
        "range_card_hH4JD6": {
          "type": "range_card",
          "settings": {
            "name": "HELIOCARE",
            "tagline": "All the dermatological photoprotection science can give you",
            "tags": "Photoprotection",
            "tags_link": "#categories",
            "summary": "<p>Advanced very high-level, full-spectrum photoprotection with options for different skin types, finishes, concerns, regimes and treatments.</p>",
            "outlet_medical": true,
            "medical_exclusive": false,
            "outlet_skin": true,
            "outlet_pharmacy": true,
            "outlet_retail": true,
            "details": "<p>Combining very high-level, full-spectrum protection against UVA, UVB, Visible Light, and Infrared-A with SPF 50+ and PA++++ protection, and exclusive ASPA-Fernblock® technology, HELIOCARE 360° sunscreens and supplements provide medical-grade personalised support for long-term skin health.</p>"
          }
        }
      },
