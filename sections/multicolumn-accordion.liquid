{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .mc-acc .multicolumn-list__item { display: flex; }
  .mc-acc .multicolumn-card { display: flex; flex-direction: column; width: 100%; height: 100%; }
  /* One padding value for the whole card body, so heading, text, toggle and link share the same edge */
  .mc-acc .multicolumn-card__info {
    display: flex; flex-direction: column; gap: 1.2rem; flex-grow: 1;
    padding: 2.8rem 2.4rem;
  }
  @media screen and (min-width: 750px) {
    .mc-acc .multicolumn-card__info { padding: 4rem; }
  }
  .mc-acc.background-none .multicolumn-card__info { padding-left: 0; padding-right: 0; }
  /* Strip any inherited or pasted spacing from the children (lists keep their bullet indent) */
  .mc-acc .multicolumn-card__info > *,
  .mc-acc .multicolumn-card__info .rte { margin: 0; padding-left: 0; padding-right: 0; text-indent: 0; }
  .mc-acc .multicolumn-card__info .rte > :not(ul):not(ol) { margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; text-indent: 0; }
  .mc-acc .multicolumn-card__info .rte > * { margin-top: 0; margin-bottom: 0; }
  .mc-acc .multicolumn-card__info .rte > * + * { margin-top: 1.2rem; }
  .mc-acc .rte sup { font-size: 0.6em; line-height: 0; vertical-align: super; }
  .mc-acc .rte sup a { text-decoration: none; font-weight: 700; }
  .mc-acc__toggle {
    display: inline-flex; align-items: center; gap: 0.8rem; align-self: flex-start;
    margin-top: auto; padding: 0; min-height: 4.4rem; background: none; border: 0; cursor: pointer;
    font-family: inherit; font-size: 1.5rem; font-weight: 700; letter-spacing: 0.1rem;
    color: rgb(var(--color-link));
  }
  .mc-acc .center .mc-acc__toggle { align-self: center; }
  .mc-acc__toggle .svg-wrapper { width: 1rem; height: 1rem; transition: transform 0.2s ease; }
  .mc-acc__toggle[aria-expanded='true'] .svg-wrapper { transform: rotate(180deg); }
  .mc-acc__toggle:focus-visible { outline: 0.2rem solid rgba(var(--color-foreground), 0.5); outline-offset: 0.3rem; }
  .mc-acc .multicolumn-card__info .link { margin-top: 0; }
</style>

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="mc-acc multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title{% if section.settings.title_alignment == 'center' %} center{% endif %}" style="{% if section.settings.title_alignment == 'center' %}justify-content: center; text-align: center;{% endif %}">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--mobile grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.image == blank and block.settings.title == blank and block.settings.text == blank -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}"
            {{ block.shopify_attributes }}
          >
            <div class="multicolumn-card content-container">
              {%- if block.settings.image != blank -%}
                {%- if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' -%}
                  {%- assign spaced_image = true -%}
                {%- endif -%}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- endif -%}

              <div class="multicolumn-card__info">
                {%- if block.settings.title != blank -%}
                  <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="rte">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.hidden_text != blank -%}
                  <div class="rte" id="McAccPanel-{{ block.id }}" hidden>{{ block.settings.hidden_text }}</div>
                  <button
                    type="button"
                    class="mc-acc__toggle"
                    aria-expanded="false"
                    aria-controls="McAccPanel-{{ block.id }}"
                    data-more="{{ section.settings.read_more_label | escape }}"
                    data-less="{{ section.settings.read_less_label | escape }}"
                  >
                    <span class="mc-acc__label">{{ section.settings.read_more_label | escape }}</span>
                    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </button>
                {%- endif -%}

                {%- if block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper"><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide medium-hide">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.button_label != blank -%}
      <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.mc-acc__toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var panel = document.getElementById(btn.getAttribute('aria-controls'));
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (panel) panel.hidden = open;
        btn.querySelector('.mc-acc__label').textContent = open ? btn.dataset.more : btn.dataset.less;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Multicolumn accordion",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Understanding sensitive & reactive skin" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ]
    },
    {
      "type": "select", "id": "title_alignment", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ]
    },
    {
      "type": "select", "id": "image_width", "label": "Image width", "default": "full",
      "options": [
        { "value": "third", "label": "One-third width of column" },
        { "value": "half", "label": "Half width of column" },
        { "value": "full", "label": "Full width of column" }
      ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" }
      ]
    },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "step": 1, "default": 3, "label": "Number of columns on desktop" },
    {
      "type": "select", "id": "column_alignment", "label": "Column alignment on desktop", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ]
    },
    {
      "type": "select", "id": "background_style", "label": "Column background", "default": "primary",
      "options": [ { "value": "none", "label": "None" }, { "value": "primary", "label": "Show column background" } ]
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "header", "content": "Accordion" },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "read_less_label", "label": "Read less label", "default": "Read less" },
    { "type": "header", "content": "Mobile layout" },
    {
      "type": "select", "id": "columns_mobile", "label": "Number of columns on mobile", "default": "1",
      "options": [ { "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" } ]
    },
    { "type": "checkbox", "id": "swipe_on_mobile", "default": true, "label": "Enable swipe on mobile" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Column" },
        { "type": "html", "id": "text", "label": "Visible text", "info": "HTML allowed, e.g. <p> and <sup>." },
        { "type": "html", "id": "hidden_text", "label": "Hidden text", "info": "Shown when Read more is clicked. Leave empty to hide the button." },
        { "type": "text", "id": "link_label", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn with accordion",
      "blocks": [ { "type": "column" }, { "type": "column" }, { "type": "column" } ]
    }
  ]
}
{% endschema %}