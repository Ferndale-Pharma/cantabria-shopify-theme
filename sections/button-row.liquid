{%- style -%}
  #ButtonRow-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #ButtonRow-{{ section.id }} .button-row__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ section.settings.desktop_alignment }};
    gap: {{ section.settings.button_gap }}px;
  }

  #ButtonRow-{{ section.id }} .button-row__button-wrapper {
    display: flex;
  }

  #ButtonRow-{{ section.id }} .button-row__button-wrapper .button {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #ButtonRow-{{ section.id }} .button-row__buttons {
      {% if section.settings.mobile_layout == 'stacked' %}
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        overflow: visible;
      {% else %}
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: flex-start;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding-bottom: 0.5rem;
      {% endif %}
    }

    {% if section.settings.mobile_layout == 'horizontal' %}
      #ButtonRow-{{ section.id }} .button-row__buttons::-webkit-scrollbar {
        display: none;
      }

      #ButtonRow-{{ section.id }} .button-row__button-wrapper {
        flex: 0 0 auto;
      }

      #ButtonRow-{{ section.id }} .button-row__button-wrapper .button {
        white-space: nowrap;
      }
    {% endif %}

    {% if section.settings.mobile_layout == 'stacked' %}
      #ButtonRow-{{ section.id }} .button-row__button-wrapper {
        width: 100%;
      }

      #ButtonRow-{{ section.id }} .button-row__button-wrapper .button {
        width: 100%;
      }
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    #ButtonRow-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="ButtonRow-{{ section.id }}"
  class="button-row color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="button-row__buttons">
      {%- for block in section.blocks -%}
        {%- if block.settings.button_label != blank -%}
          <div
            class="button-row__button-wrapper color-{{ block.settings.color_scheme }} gradient"
            {{ block.shopify_attributes }}
          >
            <a
              {% if block.settings.button_link == blank %}
                role="link"
                aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
              class="button{% if block.settings.button_style == 'secondary' %} button--secondary{% else %} button--primary{% endif %}"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Button row",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Desktop alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal scroll"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "button_gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between buttons",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ],
          "default": "primary"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Button colour scheme",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Button row",
      "blocks": [
        {
          "type": "button"
        },
        {
          "type": "button"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}