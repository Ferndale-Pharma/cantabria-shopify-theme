    "custom_liquid_36TaGn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================\n     CANTABRIA LABS - PROMAP FILTERS\n     ========================================== */\n\n  /* Hide ProMap's default tag heading */\n  .scasl-see-more-content\n  > .bh-sl-filters-container.scasl-tag > label {\n    display: none !important;\n  }\n\n  /* Main filter container */\n  #scasl-tag-list-container.cl-filter-flex {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    align-items: center;\n    justify-content: flex-start;\n    column-gap: 16px !important;\n    row-gap: 12px !important;\n    width: 100% !important;\n    max-width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    list-style: none !important;\n    box-sizing: border-box;\n  }\n\n  /* Reset ProMap list items */\n  #scasl-tag-list-container.cl-filter-flex > li {\n    display: flex !important;\n    flex: 0 0 auto;\n    align-items: center;\n    width: auto !important;\n    max-width: none !important;\n    min-width: 0;\n    height: auto !important;\n    float: none !important;\n    clear: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    box-sizing: border-box;\n  }\n\n  /* Checkbox labels */\n  #scasl-tag-list-container.cl-filter-flex\n  > li label {\n    display: inline-flex !important;\n    flex: 0 0 auto;\n    align-items: center;\n    gap: 8px;\n    width: auto !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    white-space: nowrap;\n    line-height: 1.5;\n    cursor: pointer;\n  }\n\n  /* Checkbox inputs */\n  #scasl-tag-list-container.cl-filter-flex\n  input[type=\"checkbox\"] {\n    flex-shrink: 0;\n    margin: 0 !important;\n  }\n\n  /* ==========================================\n     BRAND HEADING\n     ========================================== */\n\n  #scasl-tag-list-container.cl-filter-flex::before {\n    content: \"Filter by brand\";\n    display: block;\n    flex: 0 0 100%;\n    width: 100%;\n    margin: 0 0 4px;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    box-sizing: border-box;\n    pointer-events: none;\n  }\n\n  /* ==========================================\n     RETAILER HEADING\n     ========================================== */\n\n  /*\n    display: contents allows the heading and\n    Skin Clinic checkbox to be separate flex\n    items without changing ProMap's HTML.\n  */\n\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first {\n    display: contents !important;\n  }\n\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first::before {\n    content: \"Filter by retailer type\";\n    display: block;\n    flex: 0 0 100%;\n    width: 100%;\n    margin: 8px 0 0;\n    padding-top: 16px;\n    border-top: 1px solid #e5e5e5;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    box-sizing: border-box;\n    pointer-events: none;\n  }\n\n  /* First retailer checkbox */\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first > label {\n    display: inline-flex !important;\n    align-items: center;\n    flex: 0 0 auto;\n  }\n\n  /* ==========================================\n     DESKTOP\n     ========================================== */\n\n  @media screen and (min-width: 750px) {\n\n    /* Radius and Unit side by side */\n    .scasl-see-more-content {\n      display: grid !important;\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n      column-gap: 16px;\n      row-gap: 24px;\n      align-items: start;\n    }\n\n    /* Dropdown containers */\n    .scasl-see-more-content > .form-input {\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      float: none !important;\n    }\n\n    /* Dropdown fields */\n    .scasl-see-more-content > .form-input select {\n      display: block;\n      width: 100% !important;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n\n    /* Filters span full width below dropdowns */\n    .scasl-see-more-content\n    > .bh-sl-filters-container.scasl-tag {\n      grid-column: 1 / -1;\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      padding: 0 !important;\n      float: none !important;\n    }\n\n    /* Compact desktop filter spacing */\n    #scasl-tag-list-container.cl-filter-flex {\n      column-gap: 16px !important;\n      row-gap: 12px !important;\n    }\n  }\n\n  /* ==========================================\n     MOBILE\n     ========================================== */\n\n  @media screen and (max-width: 749px) {\n\n    #scasl-tag-list-container.cl-filter-flex {\n      flex-direction: column;\n      flex-wrap: nowrap !important;\n      align-items: stretch;\n      column-gap: 0 !important;\n      row-gap: 12px !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li:not(.cl-retailer-first) {\n      width: 100% !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li label {\n      white-space: normal !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li.cl-retailer-first > label {\n      width: 100% !important;\n    }\n  }\n</style>\n\n\n<script>\n(function () {\n  'use strict';\n\n  const KEY = '__clProMapFilters';\n  const SELECTOR = '#scasl-tag-list-container';\n\n  // Remove any previously running instance.\n  if (window[KEY]?.cleanup) {\n    window[KEY].cleanup();\n  }\n\n  const brands = [\n    'ALLSKIN | MED',\n    'Biretix',\n    'Endocare',\n    'Heliocare',\n    'Neoretin',\n    'Skin Resist'\n  ];\n\n  const retailers = [\n    'Skin Clinic',\n    'Pharmacy'\n  ];\n\n  const normalise = value =>\n    String(value || '')\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .toLowerCase();\n\n  const order = new Map(\n    [...brands, ...retailers].map(\n      (name, index) => [normalise(name), index]\n    )\n  );\n\n  const retailerSet = new Set(\n    retailers.map(normalise)\n  );\n\n  let list = null;\n  let listObserver = null;\n  let loadObserver = null;\n  let frame = null;\n  let disposed = false;\n\n  function tagName(item) {\n    return normalise(\n      item.querySelector('input[name=\"tagsvalue\"]')\n        ?.value || ''\n    );\n  }\n\n  function organise() {\n    frame = null;\n\n    if (disposed || !list || !list.isConnected) {\n      if (list && !list.isConnected) {\n        listObserver?.disconnect();\n        listObserver = null;\n        list = null;\n        watchForList();\n      }\n      return;\n    }\n\n    const items = Array.from(list.children)\n      .filter(item =>\n        item.tagName === 'LI' &&\n        item.querySelector('input[name=\"tagsvalue\"]')\n      );\n\n    if (!items.length) return;\n\n    const sorted = [...items].sort((a, b) => {\n      const aName = tagName(a);\n      const bName = tagName(b);\n\n      const aOrder = order.get(aName) ?? order.size;\n      const bOrder = order.get(bName) ?? order.size;\n\n      return (aOrder - bOrder) ||\n        aName.localeCompare(bName);\n    });\n\n    const needsSorting = sorted.some(\n      (item, index) => item !== items[index]\n    );\n\n    // Update only if the ordering has changed.\n    if (needsSorting) {\n      listObserver?.disconnect();\n\n      const fragment =\n        document.createDocumentFragment();\n\n      sorted.forEach(item => {\n        fragment.appendChild(item);\n      });\n\n      list.appendChild(fragment);\n\n      listObserver?.observe(list, {\n        childList: true\n      });\n    }\n\n    // Apply CSS layout only once.\n    if (!list.classList.contains('cl-filter-flex')) {\n      list.classList.add('cl-filter-flex');\n    }\n\n    list.classList.remove('cl-filter-grid');\n\n    // Update retailer group marker only if needed.\n    const firstRetailer = sorted.find(\n      item => retailerSet.has(tagName(item))\n    );\n\n    const currentRetailer = list.querySelector(\n      ':scope > li.cl-retailer-first'\n    );\n\n    if (currentRetailer !== firstRetailer) {\n      currentRetailer?.classList.remove(\n        'cl-retailer-first'\n      );\n\n      firstRetailer?.classList.add(\n        'cl-retailer-first'\n      );\n    }\n\n    // Remove legacy marker if present.\n    list.querySelectorAll(\n      ':scope > li.cl-brand-first'\n    ).forEach(item => {\n      item.classList.remove('cl-brand-first');\n    });\n  }\n\n  // Combine multiple mutations into one frame.\n  function scheduleOrganise() {\n    if (disposed || frame !== null) return;\n\n    frame = requestAnimationFrame(organise);\n  }\n\n  function attach(newList) {\n    if (disposed || newList === list) return;\n\n    listObserver?.disconnect();\n\n    list = newList;\n\n    listObserver = new MutationObserver(() => {\n      scheduleOrganise();\n    });\n\n    // Watch only direct changes to the tag list.\n    listObserver.observe(list, {\n      childList: true\n    });\n\n    loadObserver?.disconnect();\n    loadObserver = null;\n\n    scheduleOrganise();\n  }\n\n  function findList() {\n    if (disposed) return false;\n\n    const found = document.querySelector(SELECTOR);\n\n    if (!found) return false;\n\n    attach(found);\n    return true;\n  }\n\n  // Wait for ProMap without using an interval.\n  function watchForList() {\n    if (disposed) return;\n\n    if (findList()) return;\n    if (loadObserver) return;\n\n    loadObserver = new MutationObserver(() => {\n      if (findList()) {\n        loadObserver?.disconnect();\n        loadObserver = null;\n      }\n    });\n\n    loadObserver.observe(document.body, {\n      childList: true,\n      subtree: true\n    });\n  }\n\n  // Handle Shopify theme editor reloads.\n  function handleSectionLoad() {\n    listObserver?.disconnect();\n    listObserver = null;\n    list = null;\n\n    loadObserver?.disconnect();\n    loadObserver = null;\n\n    if (frame !== null) {\n      cancelAnimationFrame(frame);\n      frame = null;\n    }\n\n    watchForList();\n  }\n\n  function cleanup() {\n    disposed = true;\n\n    listObserver?.disconnect();\n    loadObserver?.disconnect();\n\n    if (frame !== null) {\n      cancelAnimationFrame(frame);\n    }\n\n    document.removeEventListener(\n      'shopify:section:load',\n      handleSectionLoad\n    );\n  }\n\n  window[KEY] = { cleanup };\n\n  document.addEventListener(\n    'shopify:section:load',\n    handleSectionLoad\n  );\n\n  if (document.body) {\n    watchForList();\n  } else {\n    document.addEventListener(\n      'DOMContentLoaded',\n      watchForList,\n      { once: true }\n    );\n  }\n})();\n</script>",
