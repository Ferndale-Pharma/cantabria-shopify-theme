{% comment %}
  Header (heading + subheading on the left, intro text on the right), then a grid of
  category cards: image, title, tag pills, description and a "View more" link.
  3 columns on desktop, 2 on tablet, swipe slider (or stacked) on mobile.
  Uses Dawn's own slider-component (global.js) and component-slider.css.
{% endcomment %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .category-cards__header {
    display: grid;
    gap: 1.6rem;
    margin-bottom: 3.2rem;
  }

  .category-cards__header--divider {
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
    padding-top: 4.8rem;
  }

  .category-cards__heading-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .category-cards__heading,
  .category-cards__subheading {
    margin: 0;
  }

  .category-cards__subheading {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.4;
  }

  .category-cards__intro > *:first-child {
    margin-top: 0;
  }

  .category-cards__intro > *:last-child {
    margin-bottom: 0;
  }

  .category-cards__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    height: 100%;
  }

  .category-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius, 4px);
    background: rgba(var(--color-foreground), 0.04);
  }

  .category-card__media--landscape {
    aspect-ratio: 5 / 3;
  }

  .category-card__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .category-card__media--square {
    aspect-ratio: 1 / 1;
  }

  .category-card__media img,
  .category-card__media .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-card__title {
    margin: 0.6rem 0 0;
    font-size: calc(var(--font-heading-scale) * 2rem);
  }

  .category-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .category-card__tag {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: var(--buttons-radius, 4px);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1rem;
    line-height: 1.5;
    text-decoration: none;
  }

  a.category-card__tag:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .category-card__text > *:first-child {
    margin-top: 0;
  }

  .category-card__text > *:last-child {
    margin-bottom: 0;
  }

  .category-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    margin-top: auto;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.1rem;
    color: rgb(var(--color-link));
    text-decoration: none;
  }

  .category-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .category-card__link svg {
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
    transition: transform var(--duration-short, 100ms) ease;
  }

  .category-card__link:hover svg {
    transform: translateX(0.3rem);
  }

  @media screen and (min-width: 750px) {
    .category-card__title {
      font-size: calc(var(--font-heading-scale) * 2.4rem);
    }
  }

  @media screen and (min-width: 990px) {
    .category-cards__header {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 8.33%;
      margin-bottom: 5.6rem;
    }

    .category-cards__header--divider {
      padding-top: 7.2rem;
    }

    .category-cards__list {
      row-gap: 4rem;
    }
  }
</style>

{%- liquid
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > 1
    assign show_mobile_slider = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.hide_on_mobile %} small-hide{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding"
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id | handle }}"
    {% endif %}
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.intro != blank -%}
      <div class="category-cards__header{% if section.settings.show_divider %} category-cards__header--divider{% endif %}">
        <div class="category-cards__heading-wrap">
          {%- if section.settings.heading != blank -%}
            <h2 class="category-cards__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="category-cards__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.intro != blank -%}
          <div class="category-cards__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="category-cards__list grid grid--1-col-tablet-down grid--2-col-tablet grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--mobile grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="category-card__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <article class="category-card">
              <div class="category-card__media category-card__media--{{ section.settings.image_ratio }}">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 1000, 1200',
                      sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 4rem)',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="category-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.tags != blank -%}
                {%- assign tags = block.settings.tags | split: ',' -%}
                <div class="category-card__tags">
                  {%- for tag in tags -%}
                    {%- assign tag_label = tag | strip -%}
                    {%- if tag_label != blank -%}
                      {%- if block.settings.tags_link != blank -%}
                        <a href="{{ block.settings.tags_link }}" class="category-card__tag color-{{ section.settings.tag_color_scheme }}">{{ tag_label | escape }}</a>
                      {%- else -%}
                        <span class="category-card__tag color-{{ section.settings.tag_color_scheme }}">{{ tag_label | escape }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="category-card__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="category-card__link">
                  {{- block.settings.link_label | escape -}}
                  <span class="visually-hidden"> – {{ block.settings.title | escape }}</span>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons no-js-hidden medium-hide large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Category cards",
  "tag": "section",
  "class": "section section-category-cards",
  "max_blocks": 9,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Six Skincare Categories"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A clear, category-led approach to professional skincare"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Combining innovative, exclusive technologies with expert formulations, Cantabria Labs dermocosmetics and dermatological supplements provide specialist solutions across six key areas of skin, hair and scalp health.</p><p>The new structure makes it easier to navigate the portfolio by concern, identify the relevant ranges and tailor recommendations to individual needs and treatment journeys.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line above header",
      "default": true
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "landscape", "label": "Landscape (5:3)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "landscape"
    },
    {
      "type": "color_scheme",
      "id": "tag_color_scheme",
      "label": "Tag colour scheme",
      "default": "scheme-7"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide section on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Colours and spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 100
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID (optional)",
      "default": "categories",
      "info": "Lets buttons link to this section, e.g. #categories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags",
          "info": "Separate tags with commas, e.g. ALLSKIN | MED, ENDOCARE"
        },
        {
          "type": "url",
          "id": "tags_link",
          "label": "Tags link (optional)",
          "info": "Makes the tags clickable, e.g. #ranges"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Describe the concerns this category covers.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category cards",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Photoprotection",
            "tags": "HELIOCARE",
            "text": "<p>For all skin types and concerns as an essential part of daily skin health, helping protect against UV-induced skin damage and photoageing while supporting the prevention and management of photosensitive skin conditions, including photodermatoses.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Anti-Ageing",
            "tags": "ALLSKIN | MED, ENDOCARE",
            "text": "<p>Solutions for different stages of skin ageing, supporting concerns including fine lines, wrinkles, rough texture, enlarged pores, dullness, barrier health and advanced skin renewal.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pigmentation",
            "tags": "ALLSKIN | MED, NEORETIN",
            "text": "<p>Solutions for uneven skin tone and pigmentation concerns including dark spots, hyperpigmentation and post-inflammatory hyperpigmentation, alongside the ongoing management of melasma.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Redness & Reactive Skin",
            "tags": "ALLSKIN | MED, SKIN RESIST",
            "text": "<p>Solutions for reactive and sensitive skin presenting with persistent redness, sensitivity, irritation or impaired barrier function, including sensitive and rosacea-prone skin.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Acne-Prone Skin",
            "tags": "ALLSKIN | MED, BIRETIX",
            "text": "<p>Solutions for acne and blemish-prone skin presenting with breakouts, imperfections, excess oil and shine, including additional skin support during prescription acne treatments.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hair & Scalp Health",
            "tags": "ALLSKIN | MED",
            "text": "<p>Solutions supporting hair and scalp health, from weak or damaged hair to hair loss requiring medical intervention, including androgenetic alopecia and telogen effluvium.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}