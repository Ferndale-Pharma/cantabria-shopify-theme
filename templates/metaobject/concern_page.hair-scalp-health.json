    "image_with_text_html_q6DMhJ": {
      "type": "image-with-text-html",
      "blocks": {
        "heading_fHyYmw": {
          "type": "heading",
          "settings": {
            "heading": "What are hair thinning and scalp concerns?",
            "heading_size": "h2"
          }
        },
        "text_gBt3Tc": {
          "type": "text",
          "settings": {
            "text": "<h3>Hair thinning</h3>\n<p>A noticeable reduction in hair density or volume, often appearing as finer strands, a widening parting or reduced coverage.</p>\n<h3>Scalp imbalance</h3>\n<p>Excess sebum, flaking and build-up can affect scalp comfort and condition, making\ntargeted cleansing and exfoliation important.</p>\n<h3>Reduced hair strength &amp; quality</h3>\n<p>Hair that becomes finer, weaker or more prone to breakage, affecting overall hair quality\nand fullness.</p>\n<p><em>These concerns can occur individually or together, making personalised scalp care and\nprofessional assessment important.</em></p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "heading_fHyYmw",
        "text_gBt3Tc"
      ],
