    "custom_liquid_36TaGn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* ==========================================\n     CANTABRIA LABS - PROMAP FILTERS\n     ========================================== */\n\n  /* Hide ProMap's default tag heading */\n  .scasl-see-more-content\n  > .bh-sl-filters-container.scasl-tag > label {\n    display: none !important;\n  }\n\n  /* Main filter container */\n  #scasl-tag-list-container.cl-filter-flex {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    align-items: center;\n    justify-content: flex-start;\n    column-gap: 16px !important;\n    row-gap: 12px !important;\n    width: 100% !important;\n    max-width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    list-style: none !important;\n    box-sizing: border-box;\n  }\n\n  /* Reset ProMap list items */\n  #scasl-tag-list-container.cl-filter-flex > li {\n    display: flex !important;\n    flex: 0 0 auto;\n    align-items: center;\n    width: auto !important;\n    max-width: none !important;\n    min-width: 0;\n    height: auto !important;\n    float: none !important;\n    clear: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    box-sizing: border-box;\n  }\n\n  /* Checkbox labels */\n  #scasl-tag-list-container.cl-filter-flex\n  > li label {\n    display: inline-flex !important;\n    flex: 0 0 auto;\n    align-items: center;\n    gap: 8px;\n    width: auto !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    white-space: nowrap;\n    line-height: 1.5;\n    cursor: pointer;\n  }\n\n  /* Checkbox inputs */\n  #scasl-tag-list-container.cl-filter-flex\n  input[type=\"checkbox\"] {\n    flex-shrink: 0;\n    margin: 0 !important;\n  }\n\n  /* ==========================================\n     BRAND HEADING\n     ========================================== */\n\n  #scasl-tag-list-container.cl-filter-flex::before {\n    content: \"Filter by brand\";\n    display: block;\n    flex: 0 0 100%;\n    width: 100%;\n    margin: 0 0 4px;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    box-sizing: border-box;\n    pointer-events: none;\n  }\n\n  /* ==========================================\n     RETAILER HEADING\n     ========================================== */\n\n  /*\n    display: contents allows the heading and\n    Skin Clinic checkbox to be separate flex\n    items without changing ProMap's HTML.\n  */\n\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first {\n    display: contents !important;\n  }\n\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first::before {\n    content: \"Filter by retailer type\";\n    display: block;\n    flex: 0 0 100%;\n    width: 100%;\n    margin: 8px 0 0;\n    padding-top: 16px;\n    border-top: 1px solid #e5e5e5;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    box-sizing: border-box;\n    pointer-events: none;\n  }\n\n  /* First retailer checkbox */\n  #scasl-tag-list-container.cl-filter-flex\n  > li.cl-retailer-first > label {\n    display: inline-flex !important;\n    align-items: center;\n    flex: 0 0 auto;\n  }\n\n  /* ==========================================\n     DESKTOP\n     ========================================== */\n\n  @media screen and (min-width: 750px) {\n\n    /* Radius and Unit side by side */\n    .scasl-see-more-content {\n      display: grid !important;\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n      column-gap: 16px;\n      row-gap: 24px;\n      align-items: start;\n    }\n\n    /* Dropdown containers */\n    .scasl-see-more-content > .form-input {\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      float: none !important;\n    }\n\n    /* Dropdown fields */\n    .scasl-see-more-content > .form-input select {\n      display: block;\n      width: 100% !important;\n      max-width: 100%;\n      box-sizing: border-box;\n    }\n\n    /* Filters span full width below dropdowns */\n    .scasl-see-more-content\n    > .bh-sl-filters-container.scasl-tag {\n      grid-column: 1 / -1;\n      width: 100% !important;\n      max-width: none !important;\n      min-width: 0;\n      margin: 0 !important;\n      padding: 0 !important;\n      float: none !important;\n    }\n\n    /* Compact desktop filter spacing */\n    #scasl-tag-list-container.cl-filter-flex {\n      column-gap: 16px !important;\n      row-gap: 12px !important;\n    }\n  }\n\n  /* ==========================================\n     MOBILE\n     ========================================== */\n\n  @media screen and (max-width: 749px) {\n\n    #scasl-tag-list-container.cl-filter-flex {\n      flex-direction: column;\n      flex-wrap: nowrap !important;\n      align-items: stretch;\n      column-gap: 0 !important;\n      row-gap: 12px !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li:not(.cl-retailer-first) {\n      width: 100% !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li label {\n      white-space: normal !important;\n    }\n\n    #scasl-tag-list-container.cl-filter-flex\n    > li.cl-retailer-first > label {\n      width: 100% !important;\n    }\n  }\n</style>\n\n\n<script>\n/** SLSB-5018: robust Cantabria Labs brand/retailer grouping. */\n(function () {\n  'use strict';\n\n  const KEY = '__clProMapFilters';\n  const SELECTOR = '#scasl-tag-list-container';\n  if (window[KEY]?.cleanup) window[KEY].cleanup();\n\n  const brands = ['ALLSKIN | MED', 'Biretix', 'Endocare', 'Heliocare', 'Neoretin', 'Skin Resist'];\n  const retailers = ['Skin Clinic', 'Pharmacy'];\n  const normalise = value => String(value || '').replace(/\\s+/g, ' ').trim().toLowerCase();\n  const aliases = new Map([[normalise('ALLSKIN MED'), normalise('ALLSKIN | MED')]]);\n  const canonicalName = value => {\n    const name = normalise(value);\n    return aliases.get(name) ?? name;\n  };\n  const brandOrder = new Map(brands.map((name, index) => [normalise(name), index]));\n  const retailerOrder = new Map(retailers.map((name, index) => [normalise(name), index]));\n  const retailerSet = new Set(retailerOrder.keys());\n\n  let list = null;\n  let listObserver = null;\n  let loadObserver = null;\n  let frame = null;\n  let disposed = false;\n\n  function tagName(item) {\n    return canonicalName(item.querySelector('input[name=\"tagsvalue\"]')?.value || '');\n  }\n  function sortKey(name) {\n    if (brandOrder.has(name)) return [0, brandOrder.get(name), name];\n    // Only explicit retailer values may appear beneath the retailer heading.\n    if (!retailerSet.has(name)) return [1, 0, name];\n    return [2, retailerOrder.get(name), name];\n  }\n  function compareItems(a, b) {\n    const aKey = sortKey(tagName(a));\n    const bKey = sortKey(tagName(b));\n    return (aKey[0] - bKey[0]) || (aKey[1] - bKey[1]) || aKey[2].localeCompare(bKey[2]);\n  }\n\n  function organise() {\n    frame = null;\n    if (disposed || !list || !list.isConnected) {\n      if (list && !list.isConnected) {\n        listObserver?.disconnect();\n        listObserver = null;\n        list = null;\n        watchForList();\n      }\n      return;\n    }\n\n    const items = Array.from(list.children).filter(item =>\n      item.tagName === 'LI' && item.querySelector('input[name=\"tagsvalue\"]')\n    );\n    if (!items.length) return;\n\n    const sorted = [...items].sort(compareItems);\n    if (sorted.some((item, index) => item !== items[index])) {\n      listObserver?.disconnect();\n      const fragment = document.createDocumentFragment();\n      sorted.forEach(item => fragment.appendChild(item));\n      list.appendChild(fragment);\n      listObserver?.observe(list, { childList: true });\n    }\n\n    list.classList.add('cl-filter-flex');\n    list.classList.remove('cl-filter-grid');\n    const firstRetailer = sorted.find(item => retailerSet.has(tagName(item)));\n    const currentRetailer = list.querySelector(':scope > li.cl-retailer-first');\n    if (currentRetailer !== firstRetailer) {\n      currentRetailer?.classList.remove('cl-retailer-first');\n      firstRetailer?.classList.add('cl-retailer-first');\n    }\n    list.querySelectorAll(':scope > li.cl-brand-first').forEach(item =>\n      item.classList.remove('cl-brand-first')\n    );\n  }\n\n  function scheduleOrganise() {\n    if (!disposed && frame === null) frame = requestAnimationFrame(organise);\n  }\n  function attach(newList) {\n    if (disposed || newList === list) return;\n    listObserver?.disconnect();\n    list = newList;\n    listObserver = new MutationObserver(scheduleOrganise);\n    listObserver.observe(list, { childList: true });\n    loadObserver?.disconnect();\n    loadObserver = null;\n    scheduleOrganise();\n  }\n  function findList() {\n    const found = !disposed && document.querySelector(SELECTOR);\n    if (!found) return false;\n    attach(found);\n    return true;\n  }\n  function watchForList() {\n    if (disposed || findList() || loadObserver) return;\n    loadObserver = new MutationObserver(() => findList());\n    loadObserver.observe(document.body, { childList: true, subtree: true });\n  }\n  function handleSectionLoad() {\n    listObserver?.disconnect();\n    loadObserver?.disconnect();\n    listObserver = loadObserver = list = null;\n    if (frame !== null) cancelAnimationFrame(frame);\n    frame = null;\n    watchForList();\n  }\n  function cleanup() {\n    disposed = true;\n    listObserver?.disconnect();\n    loadObserver?.disconnect();\n    if (frame !== null) cancelAnimationFrame(frame);\n    document.removeEventListener('shopify:section:load', handleSectionLoad);\n  }\n\n  window[KEY] = { cleanup };\n  document.addEventListener('shopify:section:load', handleSectionLoad);\n  if (document.body) watchForList();\n  else document.addEventListener('DOMContentLoaded', watchForList, { once: true });\n})();\n\n</script>",
