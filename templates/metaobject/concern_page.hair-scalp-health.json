    "multicolumn_accordion_ffmKrY": {
      "type": "multicolumn-accordion",
      "blocks": {
        "column_rgdmjn": {
          "type": "column",
          "settings": {
            "title": "Who is affected by hair thinning?",
            "text": "<p>Hair thinning can affect both men and women, from early changes in density to more noticeable hair loss. Concerns may include reduced volume, weakened strands or changes in scalp condition.</p>",
            "hidden_text": "<p>Targeted haircare can support individuals experiencing thinning and those looking to maintain scalp health, particularly alongside professional hair regeneration treatments.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_WDdVK3": {
          "type": "column",
          "settings": {
            "title": "Why is scalp health important for hair regeneration?",
            "text": "<p>The scalp provides the environment in which hair follicles function. Excess sebum, dead skin cells and flaking can contribute to scalp imbalance, making effective cleansing and exfoliation essential for maintaining scalp condition.</p>",
            "hidden_text": "<p>Targeted regenerative ingredients can provide additional support for follicular activity and healthier-looking hair.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_9G846d": {
          "type": "column",
          "settings": {
            "title": "How can professional treatments and homecare work together?",
            "text": "<p>Professional hair regeneration treatments are designed to target follicular activity and improve hair density and quality. Advanced technologies, including Wharton Gel Complex®, can be incorporated into targeted clinical protocols.</p>",
            "hidden_text": "<p>When combined with structured homecare, these treatments provide a comprehensive approach to scalp health and ongoing haircare.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column_rgdmjn",
        "column_WDdVK3",
        "column_9G846d"
      ],
