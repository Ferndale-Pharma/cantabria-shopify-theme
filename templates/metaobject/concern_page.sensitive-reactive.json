      "settings": {
        "custom_liquid": "<div class=\"sr-stat page-width\">\n  <p class=\"sr-stat__figure\">Up to 60%</p>\n  <p class=\"sr-stat__line\">of women and up to 40% of men report sensitive &amp; reactive skin<sup>1,2</sup></p>\n  <p class=\"sr-stat__body\">Sensitive &amp; reactive skin is more likely to respond to everyday triggers – including UV exposure, changes in temperature, wind, pollution, cosmetic products, stress and hormonal changes – with visible redness and sensations such as itching, tingling or stinging.</p>\n</div>\n<style>\n  .sr-stat{display:flex;flex-direction:column;align-items:center;gap:.8rem;text-align:center}\n  .sr-stat p{margin:0}\n  .sr-stat__figure{font-family:var(--font-heading-family);font-weight:700;font-size:3.6rem;line-height:1.1;letter-spacing:.06rem;color:#165c7d}\n  .sr-stat__line{font-size:1.8rem;line-height:1.4;font-weight:700;letter-spacing:.06rem;color:#231f20}\n  .sr-stat .sr-stat__body{max-width:72rem;margin-top:.8rem;}\n  .sr-stat sup{font-size:.6em;line-height:0;vertical-align:super}\n  .sr-stat sup a{color:#165c7d;font-weight:700;text-decoration:none}\n  .sr-stat sup a:hover,.sr-stat sup a:focus-visible{text-decoration:underline}\n  @media screen and (min-width:750px){\n    .sr-stat__figure{font-size:4.8rem}\n    .sr-stat__line{font-size:2rem}\n  }\n</style>",
