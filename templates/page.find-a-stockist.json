    "custom_liquid_36TaGn": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* Main filter grid */\n  #scasl-tag-list-container.cl-filter-grid {\n    display: grid !important;\n    grid-template-columns: repeat(\n      auto-fit,\n      minmax(130px, 1fr)\n    );\n    gap: 12px 16px !important;\n    width: 100% !important;\n    max-width: 100%;\n    margin: 0 !important;\n    padding: 0 !important;\n    list-style: none !important;\n    align-items: start;\n  }\n\n  /* Reset ProMap's individual filter layout */\n  #scasl-tag-list-container.cl-filter-grid > li {\n    display: flex !important;\n    align-items: flex-start;\n    width: auto !important;\n    max-width: none !important;\n    min-width: 0;\n    height: auto !important;\n    float: none !important;\n    clear: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    position: static;\n    box-sizing: border-box;\n  }\n\n  /* Checkbox spacing */\n  #scasl-tag-list-container.cl-filter-grid > li input {\n    flex-shrink: 0;\n    margin-right: 8px;\n  }\n\n  /* Allow long names to wrap naturally */\n  #scasl-tag-list-container.cl-filter-grid > li label {\n    white-space: normal !important;\n    overflow-wrap: break-word;\n    line-height: 1.5;\n    cursor: pointer;\n  }\n\n  /* Brand heading: its own full-width row */\n  #scasl-tag-list-container.cl-filter-grid::before {\n    content: \"Filter by brand\";\n    display: block;\n    grid-column: 1 / -1;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    margin-bottom: 2px;\n  }\n\n  /* Retailer group starts on a new row */\n  #scasl-tag-list-container.cl-filter-grid\n  > li.cl-retailer-first {\n    display: block !important;\n    grid-column: 1 / -1;\n    border-top: 1px solid #e5e5e5;\n    padding-top: 18px !important;\n    margin-top: 8px !important;\n  }\n\n  /* Retailer heading */\n  #scasl-tag-list-container.cl-filter-grid\n  > li.cl-retailer-first::before {\n    content: \"Filter by retailer type\";\n    display: block;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: #333;\n    margin-bottom: 12px;\n  }\n\n  /* Mobile: single-column filters */\n  @media screen and (max-width: 749px) {\n    #scasl-tag-list-container.cl-filter-grid {\n      grid-template-columns: 1fr;\n      gap: 12px !important;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  const brands = [\n    'ALLSKIN | MED',\n    'Biretix',\n    'Endocare',\n    'Heliocare',\n    'Neoretin',\n    'Skin Resist'\n  ];\n\n  const retailers = [\n    'Skin Clinic',\n    'Pharmacy'\n  ];\n\n  const customOrder = [...brands, ...retailers];\n  const listSelector = '#scasl-tag-list-container';\n\n  const normalise = text =>\n    text.replace(/\\s+/g, ' ').trim().toLowerCase();\n\n  const orderMap = new Map(\n    customOrder.map((name, index) => [\n      normalise(name),\n      index\n    ])\n  );\n\n  const retailerSet = new Set(\n    retailers.map(normalise)\n  );\n\n  let attachedList = null;\n  let observer = null;\n\n  function organiseTags(list) {\n    const items = Array.from(list.children)\n      .filter(item => item.tagName === 'LI');\n\n    if (!items.length) return;\n\n    const label = item => normalise(item.textContent);\n\n    const priority = item => {\n      const name = label(item);\n      return orderMap.has(name)\n        ? orderMap.get(name)\n        : customOrder.length;\n    };\n\n    const sorted = [...items].sort((a, b) => {\n      return priority(a) - priority(b) ||\n        label(a).localeCompare(label(b));\n    });\n\n    const unchanged = sorted.every(\n      (item, index) => item === items[index]\n    );\n\n    if (!unchanged) {\n      observer?.disconnect();\n\n      const fragment = document.createDocumentFragment();\n\n      sorted.forEach(item => fragment.appendChild(item));\n      list.appendChild(fragment);\n    }\n\n    list.classList.add('cl-filter-grid');\n\n    sorted.forEach(item => {\n      item.classList.remove(\n        'cl-brand-first',\n        'cl-retailer-first'\n      );\n    });\n\n    const firstRetailer = sorted.find(\n      item => retailerSet.has(label(item))\n    );\n\n    if (firstRetailer) {\n      firstRetailer.classList.add('cl-retailer-first');\n    }\n\n    if (!unchanged && observer) {\n      observer.observe(list, { childList: true });\n    }\n  }\n\n  function initialise() {\n    const list = document.querySelector(listSelector);\n\n    if (!list) return;\n\n    if (list !== attachedList) {\n      observer?.disconnect();\n      attachedList = list;\n\n      observer = new MutationObserver(() => {\n        organiseTags(list);\n      });\n\n      observer.observe(list, { childList: true });\n    }\n\n    organiseTags(list);\n  }\n\n  const poll = setInterval(initialise, 250);\n\n  setTimeout(() => clearInterval(poll), 60000);\n\n  initialise();\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
